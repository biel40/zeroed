{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zeroed-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zeroed-accounts",
      // Replace with the id printed by `wrangler d1 create zeroed-accounts` before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["17 4 * * *"] },
  "vars": {
    "APP_URL": "https://zeroed.es",
    "ALLOWED_ORIGINS": "https://zeroed.es",
    "EMAIL_FROM": "Zeroed <login@zeroed.es>"
  }
}
