{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zeroed-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zeroed-accounts",
      "database_id": "fca73e0f-843b-4821-86cf-bd0dcaac7641",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["17 4 * * *"] },
  "vars": {
    // zeroed.es redirects to www, so the game runs on the www origin; the bare domain stays allowed.
    // https://localhost is the Android (Capacitor) app and app://zeroed the desktop app.
    "APP_URL": "https://www.zeroed.es",
    "ALLOWED_ORIGINS": "https://www.zeroed.es,https://zeroed.es,https://localhost,app://zeroed",
    // Web client id from Google Cloud Console (public); empty disables Google sign-in.
    "GOOGLE_CLIENT_ID": "988060754008-uetr98unfhliivf7q7340rbuj14dmrv1.apps.googleusercontent.com",
    "EMAIL_FROM": "Zeroed <login@zeroed.es>"
  }
}
