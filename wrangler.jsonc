{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zeroed-multiplayer",
  "main": "cloudflare/multiplayer.mjs",
  "compatibility_date": "2026-09-23",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "CoopRoom" }]
  },
  "exports": {
    "CoopRoom": { "type": "durable-object", "storage": "sqlite" }
  }
}
