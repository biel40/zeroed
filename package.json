{
  "name": "zeroed",
  "productName": "Zeroed",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "desktop/main.mjs",
  "description": "Browser Zombies FPS in Burned Mansion, built with Three.js and TypeScript",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "node server/multiplayer.mjs",
    "multiplayer:server": "node server/multiplayer.mjs",
    "multiplayer:test-server": "node --test server/multiplayer.test.mjs",
    "multiplayer:cloudflare:dev": "wrangler dev",
    "multiplayer:cloudflare:deploy": "wrangler deploy",
    "multiplayer:cloudflare:test": "node --test cloudflare/multiplayer.test.mjs",
    "api:dev": "wrangler dev --config cloudflare/api/wrangler.jsonc --port 8788",
    "api:db:migrate:local": "wrangler d1 migrations apply zeroed-accounts --local --config cloudflare/api/wrangler.jsonc",
    "api:seed-beta": "vite-node cloudflare/api/scripts/seed-beta.ts --",
    "api:preview-email": "vite-node cloudflare/api/scripts/preview-login-email.ts --",
    "generate:zombie-brute": "node scripts/generate-brute-asset.mjs",
    "generate:player": "node scripts/generate-soldier-asset.mjs",
    "generate:zombies": "npm run generate:zombie-brute",
    "build:player-asset": "node scripts/build-player-asset.mjs",
    "codemap": "node scripts/codemap.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "android:sync": "npm run build && npx cap sync android",
    "preandroid:apk": "node scripts/ensure-android-sdk.mjs",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "preandroid:run": "node scripts/ensure-android-sdk.mjs",
    "android:run": "npm run android:sync && cd android && gradlew.bat installDebug",
    "android:release": "node scripts/android-release.mjs",
    "android:release:apk": "node scripts/android-release.mjs --apk",
    "android:icons": "capacitor-assets generate --android --iconBackgroundColor '#0b1220' --iconBackgroundColorDark '#0b1220'",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:start": "electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --config desktop/electron-builder.json --win --x64",
    "desktop:pack:linux": "npm run desktop:build && electron-builder --config desktop/electron-builder.json --linux --x64",
    "desktop:test": "node --test desktop/appProtocol.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "hono": "^4.13.16",
    "three": "^0.178.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^26.2.0",
    "@types/three": "^0.178.0",
    "@types/ws": "^8.18.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "fbx2gltf": "^0.9.7-p1",
    "gifenc": "^1.0.3",
    "sharp": "^0.32.6",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.137.0"
  }
}
