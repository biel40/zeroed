{
  "name": "zeroed",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Browser Zombies FPS in Burned Mansion, built with Three.js and TypeScript",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "node server/multiplayer.mjs",
    "multiplayer:server": "node server/multiplayer.mjs",
    "multiplayer:test-server": "node --test server/multiplayer.test.mjs",
    "multiplayer:cloudflare:dev": "wrangler dev",
    "multiplayer:cloudflare:deploy": "wrangler deploy",
    "multiplayer:cloudflare:test": "node --test cloudflare/multiplayer.test.mjs",
    "generate:zombie-brute": "node scripts/generate-brute-asset.mjs",
    "generate:zombies": "npm run generate:zombie-brute",
    "build:player-asset": "node scripts/build-player-asset.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "android:sync": "npm run build && npx cap sync android",
    "preandroid:apk": "node scripts/ensure-android-sdk.mjs",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "preandroid:run": "node scripts/ensure-android-sdk.mjs",
    "android:run": "npm run android:sync && cd android && gradlew.bat installDebug",
    "android:icons": "capacitor-assets generate --android --iconBackgroundColor '#0b1220' --iconBackgroundColorDark '#0b1220'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "three": "^0.178.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^26.2.0",
    "@types/three": "^0.178.0",
    "@types/ws": "^8.18.1",
    "fbx2gltf": "^0.9.7-p1",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.137.0"
  }
}
