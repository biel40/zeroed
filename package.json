{
  "name": "threejs-shooting-range",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Browser Zombies FPS with two arenas, built with Three.js and TypeScript",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "generate:zombie-brute": "node scripts/generate-brute-asset.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "android:sync": "npm run build && npx cap sync android",
    "android:run": "npm run android:sync && cd android && gradlew.bat installDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/node": "^26.2.0",
    "@types/three": "^0.178.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  }
}
